function mtvOf(cc, ps){
  if(cc === 'ELEKTRLİKLİ'){
    return (ps && ps >= 300) ? MTV_ELEKTRIK_YUKSEK_GUC : MTV_ELEKTRIK_NORMAL;
  }
  return MTV_TABLE[cc] || 0;
}

function extractPS(name){
  const m = name.match(/(\d+)\s*PS/i);
  return m ? parseInt(m[1], 10) : null;
}

function todayStr(){
  const d = new Date();
  return d.toISOString().slice(0,10);
}

function lookupCampaignPct(name, dateStr){
  const entry = CAMPAIGN[name];
  if(!entry) return 0;
  if(entry.flat !== undefined) return entry.flat;
  for(const band of entry.bands){
    if(band.since === null || dateStr >= band.since) return band.pct;
  }
  return entry.bands[entry.bands.length-1].pct;
}

let state = {
  model: null,
  kamu: 1.0,
  bayi: 1.5,
  kamp: 0.0,
  faturaDonem: '2026-09-01',
  activeFatura: null,
  matrahDestegi: false
};

function fmtTL(n, decimals){
  decimals = decimals === undefined ? 0 : decimals;
  return '₺' + n.toLocaleString('tr-TR', {minimumFractionDigits:decimals, maximumFractionDigits:decimals});
}
function fmtCC(cc){
  return cc === 'ELEKTRLİKLİ' ? 'Elektrikli' : cc + ' cc';
}
function seriesOf(name){
  return name.split(' ')[0];
}

function openModal(id){ document.getElementById(id).classList.add('show'); }
function closeModal(id){ document.getElementById(id).classList.remove('show'); }

function openModelModal(){
  document.getElementById('searchInput').value = '';
  renderModelList();
  openModal('modelOverlay');
  setTimeout(()=>document.getElementById('searchInput').focus(), 60);
}

function renderModelList(){
  const q = document.getElementById('searchInput').value.trim().toLowerCase();
  const filtered = MODELS.filter(m => m.name.toLowerCase().includes(q));
  const groups = {};
  filtered.forEach(m => {
    const s = seriesOf(m.name);
    if(!groups[s]) groups[s] = [];
    groups[s].push(m);
  });
  const container = document.getElementById('modelList');
  if(filtered.length === 0){
    container.innerHTML = '<div class="no-results">Eşleşen model bulunamadı.</div>';
    return;
  }
  let html = '';
  Object.keys(groups).sort().forEach(series => {
    html += `<div class="series-group-label" style="padding:9px 16px;background:var(--paper-2);font-size:11px;text-transform:uppercase;letter-spacing:0.8px;font-weight:700;color:var(--forest-700);">${series}</div>`;
    groups[series].forEach(m => {
      html += `<button class="model-row" onclick="selectModel('${m.name.replace(/'/g,"\\'")}')">
        <span class="mname">${m.name}</span>
        <span class="mtag">${fmtCC(m.cc)} · ${fmtTL(m.fatura)}</span>
      </button>`;
    });
  });
  container.innerHTML = html;
}

function selectModel(name){
  const m = MODELS.find(x => x.name === name);
  if(!m) return;
  state.model = m;
  state.faturaDonem = '2026-09-01';
  state.activeFatura = m.fatura;
  state.kamp = lookupCampaignPct(m.name, state.faturaDonem);
  state.matrahDestegi = false;
  closeModal('modelOverlay');
  updateVehicleBar();
  openParamModal();
}

function faturaForDonem(name, since){
  if(since === '2026-09-01'){
    const m = MODELS.find(x => x.name === name);
    return m ? m.fatura : null;
  }
  const hist = FATURA_HISTORY[name];
  if(!hist) return null;
  const entry = hist.find(e => e.since === since);
  return entry ? entry.fatura : null;
}

function openCustomModal(){
  document.getElementById('customName').value = '';
  document.getElementById('customFatura').value = '';
  document.getElementById('customNoter').value = '';
  document.getElementById('customCC').value = '1500';
  openModal('customOverlay');
  setTimeout(()=>document.getElementById('customFatura').focus(), 60);
}

function submitCustomPrice(){
  const faturaRaw = document.getElementById('customFatura').value;
  const fatura = parseFloat(faturaRaw);
  if(!faturaRaw || isNaN(fatura) || fatura <= 0){
    alert('Lütfen geçerli bir fatura bedeli girin.');
    document.getElementById('customFatura').focus();
    return;
  }
  const ccRaw = document.getElementById('customCC').value;
  const cc = ccRaw === 'ELEKTRLİKLİ' ? 'ELEKTRLİKLİ' : Number(ccRaw);
  const noterRaw = document.getElementById('customNoter').value;
  const noter = noterRaw ? parseFloat(noterRaw) : 0;
  const label = document.getElementById('customName').value.trim() || 'Özel Fiyat Girişi';

  state.model = { name: label, cc: cc, fatura: fatura, noter: noter, custom: true };
  state.kamp = 0;
  state.activeFatura = fatura;
  state.matrahDestegi = false;

  closeModal('customOverlay');
  updateVehicleBar();
  openParamModal();
}

function updateVehicleBar(){
  const m = state.model;
  document.getElementById('vbName').textContent = m.name + (m.custom ? '  ·  Özel Giriş' : '');
  document.getElementById('vbCC').textContent = fmtCC(m.cc);
  document.getElementById('vbFatura').textContent = 'DS Fatura: ' + fmtTL(state.activeFatura !== null ? state.activeFatura : m.fatura);
  document.getElementById('vehicleBar').classList.add('show');
  document.getElementById('emptyHero').style.display = 'none';
  document.getElementById('compareSection').style.display = 'none';
}

function openParamModal(){
  const isCustom = state.model && state.model.custom;
  document.getElementById('tarihField').style.display = isCustom ? 'none' : '';
  if(!isCustom){
    document.getElementById('faturaDonem').value = state.faturaDonem;
  }
  document.getElementById('kamuRange').value = state.kamu;
  document.getElementById('bayiRange').value = state.bayi;
  document.getElementById('kampRange').value = state.kamp;
  document.getElementById('matrahDestegi').checked = state.matrahDestegi;
  syncParamInputs('kamu');
  syncParamInputs('bayi');
  syncParamInputs('kamp');
  openModal('paramOverlay');
}

function onFaturaDonemChange(){
  if(!state.model || state.model.custom) return;
  state.faturaDonem = document.getElementById('faturaDonem').value;
  const fatura = faturaForDonem(state.model.name, state.faturaDonem);
  if(fatura !== null) state.activeFatura = fatura;
  const pct = lookupCampaignPct(state.model.name, state.faturaDonem);
  document.getElementById('kampRange').value = pct;
  syncParamInputs('kamp');
}

function paramLimits(which){
  return which === 'kamp' ? [0, 20] : [0, 10];
}
function clampRound(v, min, max){
  v = Math.round(v * 10) / 10;
  if(v < min) v = min;
  if(v > max) v = max;
  return v;
}
function clampFine(v, min, max){
  v = Math.round(v * 100) / 100;
  if(v < min) v = min;
  if(v > max) v = max;
  return v;
}
function stepParam(which, delta){
  const rangeEl = document.getElementById(which + 'Range');
  const [min, max] = paramLimits(which);
  const v = clampRound((parseFloat(rangeEl.value) || 0) + delta, min, max);
  rangeEl.value = v;
  syncParamInputs(which);
}
function manualParam(which){
  const inputEl = document.getElementById(which + 'Input');
  const rangeEl = document.getElementById(which + 'Range');
  const [min, max] = paramLimits(which);
  let v = parseFloat(inputEl.value.replace(',', '.'));
  if(isNaN(v)) v = parseFloat(rangeEl.value) || 0;
  v = clampFine(v, min, max);
  rangeEl.value = v;
  syncParamInputs(which);
}

function syncParamInputs(which){
  if(which==='kamu'){
    const v = parseFloat(document.getElementById('kamuRange').value);
    document.getElementById('kamuInput').value = v.toFixed(2);
  }
  if(which==='bayi'){
    const v = parseFloat(document.getElementById('bayiRange').value);
    document.getElementById('bayiInput').value = v.toFixed(2);
  }
  if(which==='kamp'){
    const v = parseFloat(document.getElementById('kampRange').value);
    document.getElementById('kampInput').value = v.toFixed(2);
  }
  const kamu = parseFloat(document.getElementById('kamuRange').value) || 0;
  const kamp = parseFloat(document.getElementById('kampRange').value) || 0;
  document.getElementById('tabanWarning').style.display = (kamu + kamp) > 10 ? 'block' : 'none';
}

function applyParams(){
  state.kamu = parseFloat(document.getElementById('kamuRange').value);
  state.bayi = parseFloat(document.getElementById('bayiRange').value);
  state.kamp = parseFloat(document.getElementById('kampRange').value);
  state.matrahDestegi = document.getElementById('matrahDestegi').checked;
  closeModal('paramOverlay');
  calculate();
}

function lookupOtvRate(cc, taxBase, ps){
  if(cc === 'ELEKTRLİKLİ'){
    const kw = (ps || 0) * KW_PER_PS;
    if(kw < ELEKTRIK_KW_ESIK){
      return taxBase <= ELEKTRIK_MATRAH_ESIK ? 25 : 55;
    }
    return taxBase <= ELEKTRIK_MATRAH_ESIK ? 65 : 75;
  }
  const tier = TIERS[cc];
  for(const [upper, rate] of tier.bands){
    if(taxBase <= upper) return rate;
  }
  return tier.bands[tier.bands.length-1][1];
}
function lookupPlaka(cc, ps){
  return mtvOf(cc, ps) + TRAFIK_RESMI_BEDEL + TRAFIK_HIZMET_BEDEL;
}

function computeBreakdown(B, cc, noter, kampPct, kamuPct, bayiPct, ps, matrahDestegi){
  const D = kampPct/100, E = kamuPct/100, G = bayiPct/100;
  const T = B * 0.9;                          // ÖTV Matrahı En Düşük Bedel
  const W = B * D;
  const X = E * B;
  const Y = T * G;
  const H = B - W - X;
  const I = H - Y;
  // Matrah Desteği geçerliyse (Yüce Auto matrah farkını karşılıyorsa) taban devreye girmez,
  // ÖTV doğrudan gerçek indirimli tutardan (H) hesaplanır. Aksi halde %90 taban uygulanır.
  const taxBase = matrahDestegi ? H : Math.max(H, T);
  const J = lookupOtvRate(cc, taxBase, ps);
  const K = taxBase * J / 100;
  const M = I + K;
  const N = M * 1.2;
  const O = lookupPlaka(cc, ps);
  const P = N + O;
  const Q = noter;
  const R = P + Q;
  const S = T * (1 - G);
  return {B,T,W,X,Y,H,I,taxBase,J,K,M,N,O,P,Q,R,S};
}

function calculate(){
  const m = state.model;
  const ps = extractPS(m.name);
  const faturaB = state.activeFatura !== null ? state.activeFatura : m.fatura;
  const r = computeBreakdown(faturaB, m.cc, m.noter, state.kamp, state.kamu, state.bayi, ps, state.matrahDestegi);
  const {B,T,W,X,Y,H,I,taxBase,J,K,M,N,O,P,Q,R,S} = r;
  const D = state.kamp/100, E = state.kamu/100, G = state.bayi/100;

  document.getElementById('heroTotal').innerHTML = fmtTL(R) + ' <small>harç dahil anahtar teslim</small>';
  document.getElementById('cardOtvRate').textContent = '%' + J;
  document.getElementById('cardOtvAmount').textContent = fmtTL(K);
  document.getElementById('cardWithVat').textContent = fmtTL(N);

  document.getElementById('tablePricing').innerHTML = `
    <tr><td class="label">DS Fatura Bedeli</td><td class="val">${fmtTL(B)}</td></tr>
    <tr><td class="sub">Otomatik kampanya + YS bonus (%${(D*100).toFixed(1)})</td><td class="val">− ${fmtTL(W)}</td></tr>
    <tr><td class="sub">Kamu / daimi indirimi (%${(E*100).toFixed(1)})</td><td class="val">− ${fmtTL(X)}</td></tr>
    <tr class="total"><td class="label">İndirimli Tutar</td><td class="val">${fmtTL(H)}</td></tr>
    <tr><td class="sub">Bayi özel indirimi (%${(G*100).toFixed(1)}, ÖTV matrahı üzerinden)</td><td class="val">− ${fmtTL(Y)}</td></tr>
    <tr class="total"><td class="label">Bayi Özel İndirimli Tutar</td><td class="val">${fmtTL(I)}</td></tr>
  `;

  const floorActive = taxBase > H + 0.5;
  const matrahLabel = state.matrahDestegi
    ? '(Matrah Desteği — taban uygulanmadı)'
    : (floorActive ? '(⚠ taban devrede)' : '(İndirimli Tutar)');
  const matrahRowStyle = state.matrahDestegi ? 'background:#e9f3e3;' : (floorActive ? 'background:#fdf0e0;' : '');
  document.getElementById('tableTax').innerHTML = `
    <tr><td class="label">ÖTV Matrahı En Düşük Bedel (Fatura × 0,90)</td><td class="val">${fmtTL(T)}</td></tr>
    <tr><td class="sub">%10'dan fazla indirimde dahi ÖTV bu tabandan hesaplanır — Matrah Desteği hariç</td><td class="val"></td></tr>
    <tr><td class="label">Silindir Hacmi / Özellik${ps ? ' ('+ps+' PS)' : ''}</td><td class="val">${fmtCC(m.cc)}</td></tr>
    <tr class="total" style="${matrahRowStyle}"><td class="label">Kullanılan ÖTV Matrahı ${matrahLabel}</td><td class="val">${fmtTL(taxBase)}</td></tr>
    <tr><td class="label">Uygulanan ÖTV Oranı</td><td class="val">%${J}</td></tr>
    <tr class="total"><td class="label">Beyan ÖTV Tutarı</td><td class="val">${fmtTL(K)}</td></tr>
  `;

  const mtv = mtvOf(m.cc, ps);
  document.getElementById('tableFinal').innerHTML = `
    <tr><td class="label">Araç + ÖTV</td><td class="val">${fmtTL(M)}</td></tr>
    <tr><td class="label">Araç + ÖTV + KDV (%20)</td><td class="val">${fmtTL(N)}</td></tr>
    <tr><td class="label">Motorlu Taşıtlar Vergisi (MTV)</td><td class="val">${fmtTL(mtv, 2)}</td></tr>
    <tr><td class="sub">Trafik Tescil Resmi Bedeli</td><td class="val">${fmtTL(TRAFIK_RESMI_BEDEL, 2)}</td></tr>
    <tr><td class="sub">Trafik Tescil Hizmet Bedeli</td><td class="val">${fmtTL(TRAFIK_HIZMET_BEDEL, 2)}</td></tr>
    <tr class="total"><td class="label">Anahtar Teslim Fiyatı</td><td class="val">${fmtTL(P)}</td></tr>
    <tr><td class="label">Noter Harcı</td><td class="val">${fmtTL(Q, 2)}</td></tr>
    <tr class="total"><td class="label">Harç Dahil Toplam</td><td class="val">${fmtTL(R)}</td></tr>
  `;

  document.getElementById('results').classList.add('show');
  document.getElementById('results').scrollIntoView({behavior:'smooth', block:'start'});
}

function openCompareModal(){
  if(!state.model){ return; }
  document.getElementById('compareCurrentLabel').textContent = fmtTL(state.activeFatura !== null ? state.activeFatura : state.model.fatura);
  document.getElementById('compareOld').value = '';
  openModal('compareOverlay');
  setTimeout(()=>document.getElementById('compareOld').focus(), 60);
}

function submitCompare(){
  const oldRaw = document.getElementById('compareOld').value;
  const oldFatura = parseFloat(oldRaw);
  if(!oldRaw || isNaN(oldFatura) || oldFatura <= 0){
    alert('Lütfen geçerli bir eski fatura bedeli girin.');
    document.getElementById('compareOld').focus();
    return;
  }
  const m = state.model;
  const ps = extractPS(m.name);
  const rNew = computeBreakdown(state.activeFatura !== null ? state.activeFatura : m.fatura, m.cc, m.noter, state.kamp, state.kamu, state.bayi, ps, state.matrahDestegi);
  const rOld = computeBreakdown(oldFatura, m.cc, m.noter, state.kamp, state.kamu, state.bayi, ps, state.matrahDestegi);

  const rows = [
    ['DS Fatura Bedeli', 'B'],
    ['İndirimli Tutar', 'H'],
    ['ÖTV Oranı (%)', 'J', true],
    ['Beyan ÖTV Tutarı', 'K'],
    ['Araç + ÖTV + KDV', 'N'],
    ['Anahtar Teslim Fiyatı', 'P'],
    ['Harç Dahil Toplam', 'R']
  ];

  let html = '';
  rows.forEach(([label, key, isPct]) => {
    const oldV = rOld[key], newV = rNew[key];
    const diff = newV - oldV;
    const diffFmt = isPct ? (diff>=0?'+':'') + diff + ' puan' : (diff>=0?'+ ':'− ') + fmtTL(Math.abs(diff));
    const diffColor = diff > 0 ? 'var(--amber)' : (diff < 0 ? 'var(--forest-700)' : 'var(--ink-soft)');
    const isTotal = key === 'R';
    html += `<tr${isTotal ? ' class="total"' : ''}>
      <td class="label">${label}</td>
      <td class="val">${isPct ? '%'+oldV : fmtTL(oldV)}</td>
      <td class="val">${isPct ? '%'+newV : fmtTL(newV)}</td>
      <td class="val" style="color:${diffColor};">${diffFmt}</td>
    </tr>`;
  });

  document.getElementById('tableCompare').innerHTML = `
    <tr><td class="label"></td><td class="val" style="color:var(--ink-soft);font-size:12px;">ESKİ</td><td class="val" style="color:var(--ink-soft);font-size:12px;">GÜNCEL</td><td class="val" style="color:var(--ink-soft);font-size:12px;">FARK</td></tr>
    ${html}
  `;

  closeModal('compareOverlay');
  document.getElementById('compareSection').style.display = 'block';
  document.getElementById('compareSection').scrollIntoView({behavior:'smooth', block:'start'});
}
const CREDIT_TYPES = {
  'bireysel': {
    label: 'Bireysel Müşteri',
    katsayi: 1.30,
    vergi: 'KKDF %15 + BSMV %15 (Faiz × 1,30)',
    ticari: false
  },
  'bireysel-vl-b': {
    label: 'Bireysel Vergi Levhalı — Bireysel Başvuru',
    katsayi: 1.30,
    vergi: 'KKDF %15 + BSMV %15 (Faiz × 1,30)',
    ticari: false
  },
  'bireysel-vl-t': {
    label: 'Bireysel Vergi Levhalı — Ticari Başvuru',
    katsayi: 1.05,
    vergi: 'KKDF %0 + BSMV %5 (Faiz × 1,05)',
    ticari: true
  },
  'tuzel': {
    label: 'Tüzel Müşteri (LTD, A.Ş.)',
    katsayi: 1.05,
    vergi: 'KKDF %0 + BSMV %5 (Faiz × 1,05)',
    ticari: true
  }
};

let creditState = { type: null, faiz: 3.50, tutar: 0, vade: 12 };
let lastCreditResult = null;

function creditBase(){
  const m = state.model;
  if(!m) return 0;
  const ps = extractPS(m.name);
  const faturaB = state.activeFatura !== null ? state.activeFatura : m.fatura;
  const r = computeBreakdown(faturaB, m.cc, m.noter, state.kamp, state.kamu, state.bayi, ps, state.matrahDestegi);
  return r.N;
}

function creditLimits(typeKey, base){
  const t = CREDIT_TYPES[typeKey];
  if(t.ticari){
    return {
      ltv: 0.80,
      maxTutar: base * 0.80,
      vadeler: [6,12,18,24,36,48,60],
      note: 'Ticari Taşıt Kredisi — Fatura Bedelinin %80\'ine Kadar, 60 Aya Kadar Vade.'
    };
  }
  if(base <= 1200000){
    return {
      ltv: 0.70, maxTutar: base * 0.70, vadeler: [6,12,18,24,36,48],
      note: '1.200.000 ₺ Altı Bireysel Alım — Oran/Vade Bankaya Göre Değişebilir, Teyit Alın.',
      belirsiz: true
    };
  }
  if(base < 2000000){
    return {
      ltv: 0.20, maxTutar: base * 0.20, vadeler: [6,12],
      note: 'BDDK: 1.200.001–1.999.999 ₺ Bandı — En Fazla %20 Kredi, En Fazla 12 Ay Vade.'
    };
  }
  return {
    ltv: 0, maxTutar: 0, vadeler: [],
    note: '2.000.000 ₺ ve Üzeri Bireysel Alımda (Araç + ÖTV + KDV) BDDK Taşıt Kredisi Kullandırılmaz. Ticari Statüde Başvuru Gerekir.',
    kapali: true
  };
}

function openCreditModal(){
  if(!state.model){ return; }
  document.getElementById('creditStep1').style.display = '';
  document.getElementById('creditStep2').style.display = 'none';
  openModal('creditOverlay');
}

function backToCreditStep1(){
  document.getElementById('creditStep1').style.display = '';
  document.getElementById('creditStep2').style.display = 'none';
}

function creditTutarHintText(lim, base){
  const maxPct = (lim.ltv*100).toFixed(0);
  if(lim.ltv < 0.80){
    const genel80 = base * 0.80;
    const fark = genel80 - lim.maxTutar;
    return 'Azami Kredi Tutarı: ' + fmtTL(lim.maxTutar) + ' (Araç Bedelinin %' + maxPct + '\'i — Genel %80 Tavanına Göre ' + fmtTL(fark) + ' Daha Az)';
  }
  return 'Azami Kredi Tutarı: ' + fmtTL(lim.maxTutar) + ' (Araç Bedelinin %' + maxPct + '\'i)';
}

let creditSwipeBound = false;
function bindCreditSwipe(){
  if(creditSwipeBound) return;
  creditSwipeBound = true;
  const box = document.getElementById('creditTutarBox');
  const badge = document.getElementById('creditSwipeBadge');
  let startX = null, baseVal = 0;

  function currentVal(){
    const raw = document.getElementById('creditTutarInput').value.replace(/\./g,'').replace(/[^\d]/g,'');
    return parseInt(raw,10) || 0;
  }
  function previewFromDx(dx){
    const base = creditBase();
    const steps = Math.round(dx / 40);
    const v = baseVal + steps * (base * 0.05);
    return Math.max(0, Math.min(Math.round(v), Math.round(base)));
  }

  box.addEventListener('touchstart', function(e){
    startX = e.touches[0].clientX;
    baseVal = currentVal();
  }, {passive:true});

  box.addEventListener('touchmove', function(e){
    if(startX === null) return;
    const dx = e.touches[0].clientX - startX;
    const v = previewFromDx(dx);
    const base = creditBase();
    const pct = base > 0 ? (v / base * 100) : 0;
    badge.textContent = '%' + pct.toFixed(0) + ' · ' + fmtTL(v);
    badge.style.display = 'block';
  }, {passive:true});

  box.addEventListener('touchend', function(e){
    if(startX === null) return;
    const dx = e.changedTouches[0].clientX - startX;
    startX = null;
    badge.style.display = 'none';
    if(Math.abs(dx) < 20) return;
    const v = previewFromDx(dx);
    document.getElementById('creditTutarInput').value = v.toLocaleString('tr-TR');
    renderCredit();
  }, {passive:true});
}

function selectCreditType(typeKey){
  const base = creditBase();
  const t = CREDIT_TYPES[typeKey];
  const lim = creditLimits(typeKey, base);
  creditState.type = typeKey;
  creditState.tutar = Math.round(lim.maxTutar);
  creditState.vade = lim.vadeler.length ? lim.vadeler[lim.vadeler.length-1] : 0;

  document.getElementById('creditTypeLabel').textContent = t.label;
  document.getElementById('creditTypeRule').textContent = t.vergi;
  document.getElementById('creditBaseAmount').textContent = fmtTL(base);
  document.getElementById('creditFaizInput').value = creditState.faiz.toFixed(2);
  document.getElementById('creditTutarInput').value = creditState.tutar.toLocaleString('tr-TR');

  const vadeSel = document.getElementById('creditVade');
  vadeSel.innerHTML = lim.vadeler.map(v => `<option value="${v}">${v} Ay</option>`).join('');
  vadeSel.value = creditState.vade;
  document.getElementById('creditVadeHint').textContent = lim.note;
  document.getElementById('creditTutarHint').textContent = creditTutarHintText(lim, base);

  document.getElementById('creditStep1').style.display = 'none';
  document.getElementById('creditStep2').style.display = '';
  bindCreditSwipe();
  renderCredit();
}

function stepCredit(which, delta){
  if(which === 'faiz'){
    let v = (parseFloat(document.getElementById('creditFaizInput').value.replace(',', '.')) || 0) + delta;
    v = Math.max(0, Math.round(v * 100) / 100);
    document.getElementById('creditFaizInput').value = v.toFixed(2);
  } else {
    const raw = document.getElementById('creditTutarInput').value.replace(/\./g, '').replace(/[^\d]/g, '');
    let v = (parseInt(raw, 10) || 0) + delta;
    const base = creditBase();
    v = Math.max(0, Math.min(v, Math.round(base)));
    document.getElementById('creditTutarInput').value = v.toLocaleString('tr-TR');
  }
  renderCredit();
}

function manualCredit(){
  let f = parseFloat(document.getElementById('creditFaizInput').value.replace(',', '.'));
  if(isNaN(f) || f < 0) f = 0;
  document.getElementById('creditFaizInput').value = (Math.round(f*100)/100).toFixed(2);

  const raw = document.getElementById('creditTutarInput').value.replace(/\./g, '').replace(/[^\d]/g, '');
  let t = parseInt(raw, 10) || 0;
  const base = creditBase();
  t = Math.max(0, Math.min(t, Math.round(base)));
  document.getElementById('creditTutarInput').value = t.toLocaleString('tr-TR');
  renderCredit();
}

function renderCredit(){
  const base = creditBase();
  const t = CREDIT_TYPES[creditState.type];
  const lim = creditLimits(creditState.type, base);
  const out = document.getElementById('creditResult');

  if(lim.kapali){
    out.innerHTML = `<div style="background:#fdf0e0; border-left:3px solid var(--amber); padding:12px 14px; font-size:13px; color:#7a4a12; margin:16px 0;">⚠ ${lim.note}</div>`;
    return;
  }

  const faiz = parseFloat(document.getElementById('creditFaizInput').value.replace(',', '.')) || 0;
  const rawT = document.getElementById('creditTutarInput').value.replace(/\./g, '').replace(/[^\d]/g, '');
  const P = parseInt(rawT, 10) || 0;
  const n = parseInt(document.getElementById('creditVade').value, 10) || 0;

  const warnEl = document.getElementById('creditOverLimitWarning');
  if(P > lim.maxTutar + 0.5){
    warnEl.style.display = 'block';
    warnEl.textContent = '⚠ Bu Tutar, ' + t.label + ' İçin Tipik Azami Kredi Tutarını (' + fmtTL(lim.maxTutar) + ') Aşıyor — Bankanın Onayına Bağlıdır.';
  } else {
    warnEl.style.display = 'none';
  }

  creditState.faiz = faiz; creditState.tutar = P; creditState.vade = n;

  if(P <= 0 || n <= 0){
    out.innerHTML = `<div class="hint" style="margin:16px 0;">Kredi Tutarı ve Vade Girin.</div>`;
    return;
  }

  const efektif = faiz * t.katsayi;
  const i = efektif / 100;
  const taksit = i > 0 ? (P * i) / (1 - Math.pow(1 + i, -n)) : P / n;
  const toplamGeri = taksit * n;
  const toplamMaliyet = toplamGeri - P;
  const pesinat = base - P;

  lastCreditResult = {
    vehicleName: state.model ? state.model.name : '',
    typeLabel: t.label,
    base: base, P: P, pesinat: pesinat,
    faiz: faiz, efektif: efektif, n: n,
    taksit: taksit, toplamGeri: toplamGeri, toplamMaliyet: toplamMaliyet
  };

  out.innerHTML = `
    <div id="creditShareArea" style="background:var(--paper); padding:4px;">
      <div style="background:var(--forest-950); border-radius:var(--radius); padding:20px 22px; margin:20px 0 16px;">
        <div style="font-size:12px; text-transform:uppercase; letter-spacing:1px; color:#9fd66a; font-weight:700; margin-bottom:8px;">Aylık Taksit</div>
        <div style="font-family:'Sora',sans-serif; font-weight:700; font-size:36px; color:var(--white);">${fmtTL(taksit)} <small style="font-size:16px; font-weight:500; color:#a9c2b3;">/ ay</small></div>
      </div>
      <table class="breakdown">
        <tr><td class="label">Araç</td><td class="val">${lastCreditResult.vehicleName}</td></tr>
        <tr><td class="label">Araç Bedeli</td><td class="val">${fmtTL(base)}</td></tr>
        <tr><td class="label">Kredi Tutarı</td><td class="val">${fmtTL(P)}</td></tr>
        <tr class="total"><td class="label">Peşinat</td><td class="val">${fmtTL(pesinat)}</td></tr>
        <tr><td class="label">Aylık Akdi Faiz</td><td class="val">%${faiz.toFixed(2)}</td></tr>
        <tr><td class="sub">${t.vergi}</td><td class="val"></td></tr>
        <tr><td class="label">Vade</td><td class="val">${n} Ay</td></tr>
        <tr class="total"><td class="label">Toplam Geri Ödeme</td><td class="val">${fmtTL(toplamGeri)}</td></tr>
        <tr><td class="label">Toplam Finansman Maliyeti</td><td class="val">${fmtTL(toplamMaliyet)}</td></tr>
      </table>
    </div>
    <p class="footnote" style="margin-top:14px;">${lim.note} Hesaplama eşit taksitli (anüite) yönteme göredir; banka masraf, sigorta ve tahsis ücretleri dahil değildir. Kesin rakam için banka teklifi esastır.</p>
  `;
}
</script>
