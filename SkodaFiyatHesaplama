const MTV_TABLE = { 1000: 3451.0, 1500: 6014.0, 1999: 16737.0 };
const MTV_ELEKTRIK_NORMAL = 6277.0;   // 190 PS bandı
const MTV_ELEKTRIK_YUKSEK_GUC = 31444.0; // 300+ PS bandı (e-RS 340 PS gibi)
const TRAFIK_RESMI_BEDEL = 3759.10;   // sabit, tüm modellerde aynı
