<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Araç Fiyat &amp; ÖTV Hesaplama</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --forest-950:#0E3A2F;
    --forest-900:#12483A;
    --forest-800:#175946;
    --forest-700:#1F6E56;
    --lime-500:#78FAAE;
    --lime-600:#5FE096;
    --navy:#14213D;
    --paper:#f2f4ef;
    --paper-2:#e9ece4;
    --ink:#12201a;
    --ink-soft:#4c5a52;
    --line:#d7dcd2;
    --white:#ffffff;
    --amber:#c8862a;
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Manrope', system-ui, -apple-system, sans-serif;
    font-size:15px;
    line-height:1.5;
    min-height:100vh;
  }
  .display{font-family:'Sora', Georgia, sans-serif;}

  /* ---------- Header ---------- */
  header.topbar{
    background:var(--forest-950);
    color:var(--paper);
    padding:22px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:3px solid var(--lime-500);
  }
  .brand{
    display:flex;
    align-items:baseline;
    gap:12px;
  }
  .brand .mark{
    width:34px;height:34px;
    border-radius:50%;
    background:var(--lime-500);
    display:flex;align-items:center;justify-content:center;
    color:var(--forest-950);
    font-weight:800;
    font-size:16px;
    flex:none;
  }
  .brand h1{
    font-family:'Sora', sans-serif;
    font-weight:600;
    font-size:20px;
    margin:0;
    letter-spacing:0.2px;
  }
  .brand span.tagline{
    color:#a9c2b3;
    font-size:12.5px;
  }
  .topbar .meta{
    font-size:12.5px;
    color:#9db7a7;
    text-align:right;
  }

  main{
    max-width:1040px;
    margin:0 auto;
    padding:40px 24px 90px;
  }

  /* ---------- Empty state ---------- */
  .empty-hero{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:22px;
    padding:64px 8px 40px;
    border-bottom:1px solid var(--line);
    margin-bottom:36px;
  }
  .empty-hero h2{
    font-family:'Sora', sans-serif;
    font-weight:600;
    font-size:38px;
    line-height:1.15;
    margin:0;
    max-width:640px;
  }
  .empty-hero p{
    color:var(--ink-soft);
    max-width:520px;
    font-size:15.5px;
    margin:0;
  }

  button{
    font-family:inherit;
    cursor:pointer;
  }
  .btn{
    border:none;
    padding:14px 26px;
    font-size:15px;
    font-weight:600;
    border-radius:var(--radius);
    display:inline-flex;
    align-items:center;
    gap:10px;
    transition:transform .12s ease, background .15s ease;
  }
  .btn:active{ transform:scale(0.98); }
  .btn-primary{
    background:var(--forest-900);
    color:var(--paper);
  }
  .btn-primary:hover{ background:var(--forest-800); }
  .btn-accent{
    background:var(--lime-500);
    color:var(--forest-950);
  }
  .btn-accent:hover{ background:var(--lime-600); }
  .btn-ghost{
    background:transparent;
    color:var(--navy);
    border:1.5px solid var(--navy);
    padding:12.5px 24px;
  }
  .btn-ghost:hover{ background:var(--navy); color:var(--paper); }
  .btn-sm{ padding:9px 16px; font-size:13.5px; }

  /* ---------- Selected vehicle summary bar ---------- */
  .vehicle-bar{
    display:none;
    background:var(--white);
    border:1px solid var(--line);
    padding:16px;
    margin-bottom:28px;
    flex-direction:column;
    gap:14px;
  }
  .vehicle-bar.show{ display:flex; }
  .vehicle-info-card{
    background:var(--forest-950);
    border-radius:var(--radius);
    padding:16px 18px;
  }
  .vehicle-bar .vname{
    font-family:'Sora', sans-serif;
    font-size:20px;
    font-weight:600;
    margin:0 0 4px;
    color:var(--white);
  }
  .vehicle-bar .vsub{
    font-size:13px;
    color:#9FCBB8;
    display:flex;
    gap:16px;
    flex-wrap:wrap;
  }
  .vehicle-bar .actions{
    display:grid;
    grid-template-columns:repeat(2, minmax(0,1fr));
    gap:10px;
    width:100%;
  }
  .action-btn{
    background:var(--forest-950);
    border:1.5px solid var(--navy);
    border-radius:var(--radius);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:18px 8px;
    color:var(--white);
    font-size:13px;
    font-weight:500;
    text-align:center;
  }
  .action-btn:hover{ background:var(--forest-800); }
  .action-btn:active{ transform:scale(0.98); }
  .action-btn svg{
    width:22px;
    height:22px;
    stroke:var(--lime-500);
    fill:none;
    stroke-width:1.8;
    stroke-linecap:round;
    stroke-linejoin:round;
  }

  /* ---------- Results ---------- */
  .results{ display:none; }
  .results.show{ display:block; }

  .hero-price{
    background:var(--forest-950);
    color:var(--paper);
    padding:38px 32px;
    margin-bottom:4px;
    position:relative;
    overflow:hidden;
  }
  .hero-price::after{
    content:"";
    position:absolute;
    right:-40px; top:-40px;
    width:180px;height:180px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(143,206,58,0.18), transparent 70%);
  }
  .hero-price .label{
    font-size:12.5px;
    text-transform:uppercase;
    letter-spacing:1.2px;
    color:#9fd66a;
    font-weight:700;
    margin-bottom:10px;
  }
  .hero-price .amount{
    font-family:'Sora', sans-serif;
    font-weight:700;
    font-size:46px;
    letter-spacing:-0.5px;
  }
  .hero-price .amount small{
    font-size:20px;
    font-weight:500;
    color:#a9c2b3;
    margin-left:6px;
  }
  .hero-price .breakdown-link{
    margin-top:16px;
  }

  .grid-cards{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:1px;
    background:var(--line);
    margin-bottom:28px;
  }
  .mini-card{
    background:var(--white);
    padding:20px 22px;
  }
  .credit-card-btn{
    background:var(--forest-950);
    border:none;
    padding:20px 22px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:8px;
    color:var(--white);
    font-size:14px;
    font-weight:600;
    font-family:inherit;
  }
  .credit-card-btn:hover{ background:var(--forest-800); }
  .credit-card-btn:active{ transform:scale(0.98); }
  .credit-card-btn svg{
    stroke:var(--lime-500);
    fill:none;
    stroke-width:1.8;
    stroke-linecap:round;
    stroke-linejoin:round;
  }
  .type-btn{
    width:100%;
    text-align:left;
    padding:14px 16px;
    border:1.5px solid var(--navy);
    background:var(--white);
    border-radius:10px;
    font-family:inherit;
    font-size:14px;
    font-weight:600;
    color:var(--navy);
    margin-bottom:10px;
  }
  .type-btn:hover{ background:var(--paper-2); }
  .type-btn .sub{
    display:block;
    font-weight:400;
    font-size:12px;
    color:var(--ink-soft);
    margin-top:4px;
  }
  .mini-card .k{
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.6px;
    color:var(--ink-soft);
    font-weight:600;
    margin-bottom:8px;
  }
  .mini-card .v{
    font-family:'Sora', sans-serif;
    font-size:22px;
    font-weight:600;
  }
  .mini-card .v.sub{ font-size:13px; color:var(--ink-soft); font-weight:500; font-family:'Manrope';}

  .section-title{
    font-family:'Sora', sans-serif;
    font-size:15px;
    font-weight:600;
    color:var(--forest-900);
    margin:34px 0 12px;
    padding-bottom:8px;
    border-bottom:1.5px solid var(--forest-900);
    display:flex;
    justify-content:space-between;
    align-items:baseline;
  }

  table.breakdown{
    width:100%;
    border-collapse:collapse;
    background:var(--white);
  }
  table.breakdown tr{ border-bottom:1px solid var(--line); }
  table.breakdown tr:last-child{ border-bottom:none; }
  table.breakdown td{ padding:11px 16px; font-size:14px; }
  table.breakdown td.label{ color:var(--ink-soft); width:60%; }
  table.breakdown td.val{ text-align:right; font-variant-numeric:tabular-nums; font-weight:600; }
  table.breakdown tr.total td{ background:var(--paper-2); font-weight:700; }
  table.breakdown tr.total td.val{ color:var(--forest-800); }
  table.breakdown td.sub{ color:var(--ink-soft); font-weight:400; font-size:12.5px; padding-left:28px;}

  .footnote{
    margin-top:26px;
    font-size:12px;
    color:var(--ink-soft);
    line-height:1.6;
  }

  /* ---------- Modal ---------- */
  .overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(11,36,28,0.55);
    backdrop-filter:blur(2px);
    z-index:100;
    align-items:flex-start;
    justify-content:center;
    padding:5vh 16px;
    overflow-y:auto;
  }
  .overlay.show{ display:flex; }
  .modal{
    background:var(--paper);
    width:100%;
    max-width:560px;
    border-top:4px solid var(--lime-500);
    box-shadow:0 20px 60px rgba(0,0,0,0.35);
    animation:pop .18s ease;
  }
  @keyframes pop{
    from{ opacity:0; transform:translateY(8px); }
    to{ opacity:1; transform:translateY(0); }
  }
  .modal-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:22px 26px 16px;
  }
  .modal-head h3{
    font-family:'Sora', sans-serif;
    font-size:20px;
    margin:0;
  }
  .modal-head .close{
    background:none; border:none;
    font-size:22px;
    line-height:1;
    color:var(--ink-soft);
    padding:4px 8px;
  }
  .modal-head .close:hover{ color:var(--ink); }
  .modal-body{ padding:0 26px 26px; }

  .search-box{
    width:100%;
    padding:13px 16px;
    border:1.5px solid var(--line);
    background:var(--white);
    font-size:15px;
    margin-bottom:14px;
    font-family:inherit;
  }
  .search-box:focus{ outline:none; border-color:var(--forest-700); }

  .series-group{ margin-bottom:6px; }
  .series-group .series-name{
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:1px;
    color:var(--forest-700);
    font-weight:700;
    margin:16px 0 6px;
  }
  .model-list{
    max-height:52vh;
    overflow-y:auto;
    border:1px solid var(--line);
    background:var(--white);
  }
  .model-row{
    width:100%;
    text-align:left;
    background:none;
    border:none;
    border-bottom:1px solid var(--line);
    padding:13px 16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    font-size:14px;
  }
  .model-row:last-child{ border-bottom:none; }
  .model-row:hover{ background:var(--paper-2); }
  .model-row .mname{ font-weight:600; }
  .model-row .mtag{
    font-size:11.5px;
    color:var(--ink-soft);
    white-space:nowrap;
    font-variant-numeric:tabular-nums;
  }
  .no-results{ padding:24px 16px; color:var(--ink-soft); text-align:center; font-size:14px; }

  .field{ margin-bottom:20px; }
  .field label{
    display:flex;
    justify-content:space-between;
    font-size:13.5px;
    font-weight:700;
    margin-bottom:8px;
    color:var(--forest-900);
  }
  .field label .val-chip{
    background:var(--forest-950);
    color:var(--lime-500);
    padding:2px 10px;
    font-size:13px;
    font-weight:700;
    font-variant-numeric:tabular-nums;
  }
  .field input[type=range]{
    width:100%;
    accent-color:var(--forest-800);
  }
  .stepper{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:10px;
  }
  .step-btn{
    width:40px; height:40px;
    flex:none;
    border:1.5px solid var(--navy);
    background:var(--white);
    padding:0;
    border-radius:10px;
    display:flex; align-items:center; justify-content:center;
  }
  .step-btn:active{ background:var(--paper-2); }
  .step-btn svg{
    display:block;
    stroke:var(--forest-950);
    stroke-width:2.4;
    stroke-linecap:round;
  }
  .step-value-box{
    flex:1;
    min-width:0;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:4px;
    height:40px;
    border:1.5px solid var(--navy);
    border-radius:10px;
    background:var(--forest-950);
    padding:0 10px;
  }
  .step-input{
    width:64px;
    min-width:0;
    flex:none;
    text-align:right;
    font-family:'Sora', sans-serif;
    font-size:17px;
    font-weight:700;
    border:none;
    background:transparent;
    padding:0;
    color:var(--lime-500);
  }
  .step-input:focus{ outline:none; }
  .step-pct{ font-size:14px; color:var(--lime-500); flex:none; }
  .field .hint{ font-size:12px; color:var(--ink-soft); margin-top:6px; }
  .field .num-input{
    width:100%;
    padding:11px 14px;
    border:1.5px solid var(--line);
    font-size:15px;
    font-family:inherit;
    margin-top:6px;
  }
  .field .num-input:focus{ outline:none; border-color:var(--forest-700); }

  .modal-actions{
    display:flex;
    justify-content:flex-end;
    gap:10px;
    margin-top:8px;
  }

  @media (max-width:640px){
    .grid-cards{ grid-template-columns:1fr 1fr; }
    .empty-hero h2{ font-size:29px; }
    header.topbar{ padding:18px; }
    main{ padding:26px 16px 70px; }
    .hero-price .amount{ font-size:34px; }
  }
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <div class="mark">Š</div>
    <div>
      <h1>Fiyat &amp; ÖTV Hesaplama</h1>
      <div class="tagline">Škoda bayi satış aracı</div>
    </div>
  </div>
  <div class="meta">23/07/2025 tarihli ÖTV kararına göre<br>güncellenmiştir</div>
</header>

<main>

  <div class="empty-hero" id="emptyHero">
    <h2>Hangi araç için fiyat hesaplayalım?</h2>
    <p>Model seçin, kamu/daimi ve bayi özel indirim oranlarını ayarlayın; ÖTV oranı, harçlar ve KDV dahil anahtar teslim fiyatı anında hesaplansın.</p>
    <div style="display:flex; gap:12px; flex-wrap:wrap;">
      <button class="btn btn-primary" onclick="openModelModal()">Araç Seç →</button>
      <button class="btn btn-ghost" onclick="openCustomModal()">Özel Fiyat Ekle</button>
    </div>
  </div>

  <div class="vehicle-bar" id="vehicleBar">
    <div class="vehicle-info-card">
      <p class="vname" id="vbName">—</p>
      <div class="vsub">
        <span id="vbCC">—</span>
        <span id="vbFatura">—</span>
      </div>
    </div>
    <div class="actions">
      <button class="action-btn" onclick="openModelModal()">
        <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        Aracı Değiştir
      </button>
      <button class="action-btn" onclick="openCustomModal()">
        <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        Özel Fiyat Ekle
      </button>
      <button class="action-btn" onclick="openCompareModal()">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Eski Fiyatla Karşılaştır
      </button>
      <button class="action-btn" onclick="openParamModal()">
        <svg viewBox="0 0 24 24"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
        Oranları Düzenle
      </button>
    </div>
  </div>

  <div class="results" id="results">

    <div class="hero-price">
      <div class="label">Anahtar Teslim Fiyat · Harç Dahil</div>
      <div class="amount" id="heroTotal">—</div>
    </div>

    <div class="grid-cards">
      <div class="mini-card">
        <div class="k">ÖTV Oranı</div>
        <div class="v" id="cardOtvRate">—</div>
      </div>
      <div class="mini-card">
        <div class="k">Beyan ÖTV Tutarı</div>
        <div class="v" id="cardOtvAmount">—</div>
      </div>
      <div class="mini-card">
        <div class="k">Araç + ÖTV + KDV</div>
        <div class="v" id="cardWithVat">—</div>
      </div>
      <button class="credit-card-btn" onclick="openCreditModal()">
        <svg viewBox="0 0 24 24" width="22" height="22"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        Kredi Hesapla
      </button>
    </div>

    <div class="section-title">
      <span>Fiyat Yapısı</span>
      <button class="btn btn-ghost btn-sm" onclick="openParamModal()">Oranları Düzenle</button>
    </div>
    <table class="breakdown" id="tablePricing"></table>

    <div class="section-title"><span>Vergi Hesabı</span></div>
    <table class="breakdown" id="tableTax"></table>

    <div class="section-title"><span>Harçlar ve Toplam</span></div>
    <table class="breakdown" id="tableFinal"></table>

    <div id="compareSection" style="display:none;">
      <div class="section-title">
        <span>Fiyat Karşılaştırması — Eski vs Güncel</span>
        <button class="btn btn-ghost btn-sm" onclick="openCompareModal()">Değeri Güncelle</button>
      </div>
      <table class="breakdown" id="tableCompare" style="margin-bottom:8px;"></table>
    </div>

    <p class="footnote">
      Hesaplama, güncel bayi fatura bedeli, ÖTV matrahı (fatura bedelinin %90'ı) ve 23/07/2025 tarihli ÖTV oranları tablosu esas alınarak yapılmıştır. KDV oranı %20 olarak uygulanmıştır. Gerçek satış öncesi kesin fiyat için bayi teyidi alınmalıdır.
    </p>
  </div>

</main>

<!-- Model Selection Modal -->
<div class="overlay" id="modelOverlay">
  <div class="modal">
    <div class="modal-head">
      <h3>Araç Seç</h3>
      <button class="close" onclick="closeModal('modelOverlay')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="text" class="search-box" id="searchInput" placeholder="Model ara… örn. Kodiaq, Superb, Elroq" oninput="renderModelList()">
      <div class="model-list" id="modelList"></div>
    </div>
  </div>
</div>

<!-- Compare Old vs New Modal -->
<div class="overlay" id="compareOverlay">
  <div class="modal">
    <div class="modal-head">
      <h3>Eski Fiyatla Karşılaştır</h3>
      <button class="close" onclick="closeModal('compareOverlay')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label>Güncel Fatura Bedeli</label>
        <input class="num-input" id="compareCurrentLabel" disabled style="margin-top:6px;background:var(--paper-2);color:var(--ink-soft);">
      </div>
      <div class="field">
        <label>Eski Fatura Bedeli (TL)</label>
        <input type="number" class="num-input" id="compareOld" placeholder="örn. 1350000" min="0" step="0.01">
        <div class="hint">Aynı araç, aynı silindir hacmi bandı ve aynı oranlarla — sadece fatura bedeli üzerinden karşılaştırılır. Farklı oranlarla karşılaştırmak isterseniz önce "Oranları Düzenle"den güncelleyip tekrar deneyin.</div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost btn-sm" onclick="closeModal('compareOverlay')">Vazgeç</button>
        <button class="btn btn-primary" onclick="submitCompare()">Karşılaştır</button>
      </div>
    </div>
  </div>
</div>

<!-- Custom Price Entry Modal -->
<div class="overlay" id="customOverlay">
  <div class="modal">
    <div class="modal-head">
      <h3>Özel Fiyat Ekle</h3>
